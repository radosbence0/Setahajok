<Window x:Class="Setahajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Setahajok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        MinHeight="350" MinWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.33*"/>
            <ColumnDefinition Width="0.66*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Napok száma:" VerticalAlignment="Center"/>
                <TextBox x:Name="NumberOfDaysTB" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="LetsCountBTN" Content="Számoljunk!" Grid.Row="2" Margin="12,0" VerticalAlignment="Center" Height="18" Click="Button_Click"/>

            <Label x:Name="CountedLBL" Content="" Grid.Row="3" Margin="12,0" VerticalAlignment="Center" Height="27"/>

            <Grid Grid.Row="4" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Személyek száma:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center"/>
            </Grid>

            <Button Content="Keresés!" Grid.Row="5" Margin="12,0" VerticalAlignment="Center" Height="18"/>

            <Label Content="" Grid.Row="6" Margin="12,0" VerticalAlignment="Center" Height="27"/>
            <Label Content="" Grid.Row="7" Margin="12,0" VerticalAlignment="Center" Height="27"/>
        </Grid>

        <Image Grid.Column="1" Margin="50" Source="/hajo.jpg" Stretch="Fill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>